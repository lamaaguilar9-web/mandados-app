# Mandados App - Configuración de Entorno
# ATENCIÓN: NUNCA subir valores reales o secretos al repositorio git.

# Llave maestra para acceso al panel /admin
MANDADOS_ADMIN_KEY=cambiar_por_llave_secreta_en_produccion

# Modo semilla demo (1 = crea repartidores iniciales de prueba; 0 = producción vacía)
MANDADOS_SEED_DEMO=0

# Tiempo de vida máximo de un mandado en búsqueda antes de marcarlo expirado (en segundos)
MANDADOS_VIAJE_TTL_SEC=900

# Ciudad operativa por defecto y rangos tarifarios (C$)
MANDADOS_CIUDAD=Masaya
MANDADOS_TARIFA_MIN=20.0
MANDADOS_TARIFA_MAX=300.0

# Binding de red (127.0.0.1 por defecto para aislamiento loopback en el host de producción)
HOST=127.0.0.1
PORT=5058
